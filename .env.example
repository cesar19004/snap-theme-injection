#!/bin/bash

declare -A ICON_THEMES
declare -A GTK_THEMES
declare -A SOUND_THEMES

# ==============================================================================
# THEMES DEFINITION
# ==============================================================================
# Themes are categorized into a distinct associative arrays based on type.
#
# SYNTAX:
# <ARRAY_NAME>["<THEME_NAME>"] = <PATH_TO_THEME>
#
# COMPONENTS:
# 1. <ARRAY_NAME>      : Use one of the following to secify your theme by type.
#    - <ICON_THEMES>   : Use this var for icon themes.
#    - <GTK_THEMES>    : Use this var for GTK themes.
#    - <SOUND_THEMES>  : Use this var for sound themes.
# 2. <THEME_NAME>      : The unique identifier/name for the theme.
# 3. PATH_TO_THEME     : The directory path where the theme files reside.
# ==============================================================================

# --- GTK THEMES ---
# Requirement: Must be placed in the GTK_THEMES array.
# Usage: GTK_THEMES["<name>"]=<path>

#GTK_THEMES["Adwaita-Dark"]=/usr/share/themes/Adwaita-dark


# --- ICON THEMES ---
# Requirement: Must be placed in the ICON_THEMES array.
# Usage: ICON_THEMES["<name>"]=<path>

#ICON_THEMES["Papirus-Dark"]=/usr/share/icons/Papirus-Dark


# --- SOUND THEMES ---
# Requirement: Must be placed in the SOUND_THEMES array.
# Usage: SOUND_THEMES["<name>"]=<path>

#SOUND_THEMES["MacOSSounds4Gnome"]=/usr/share/sounds/MacOSSounds4Gnome